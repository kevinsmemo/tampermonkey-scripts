{
  "manifest_version": 3,
  "name": "YouTube Slides Extractor (Cloud Alpha)",
  "version": "0.4.4",
  "description": "Capture YouTube slides with a durable local queue and direct Google Drive sync.",
  "key": "",
  "permissions": [
    "identity",
    "storage",
    "alarms",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.googleapis.com/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "YouTube Slides Extractor"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "oauth2": {
    "client_id": "1026422003867-gqim3ggouplppkebu79mlhbm8d0fhp3q.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "optional_host_permissions": [
    "https://raw.githubusercontent.com/*"
  ]
}
